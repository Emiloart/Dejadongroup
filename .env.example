# Administrator sign-in. Use a strong, unique password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# One-time bootstrap only. Named staff credentials/roles persist after first sign-in.
# With explicit SUPER_ADMIN_*, ADMIN_* initially receives Media + Marketplace roles.
# Without SUPER_ADMIN_*, ADMIN_* bootstraps the existing single owner.
# Removing/changing environment credentials does not reset persisted accounts.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Partner email verification. RESEND_FROM must use a verified Resend sender.
RESEND_API_KEY=
RESEND_FROM=

# Partner registration and upgrades. Use test keys in a separate test data directory.
PAYSTACK_SECRET_KEY=
# Your public HTTPS origin, without a path. Local development may use localhost HTTP.
APP_BASE_URL=
# Random secret of at least 32 characters for the scheduled reconciliation endpoint.
PARTNER_RECONCILE_SECRET=

# Optional: directory on a persistent disk for the catalogue and uploaded photos.
# Defaults to .data inside the project. Use one application instance with this store.
# DEJADON_DATA_DIR=/absolute/path/to/persistent/dejadon-data
